{
    "manifest_version": 3,
    "name": "Investigating Search Interface",
    "version": "2.1.0",
    "description": "Surfaces short, expert-authored reflection prompts alongside Google search results. A University of Birmingham research project (formerly the Ethical Interface).",
    "permissions": ["storage"],
    "host_permissions": [
        "http://localhost:8000/*",
        "https://*.onrender.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.google.com/search*",
                "https://www.google.co.uk/search*",
                "https://www.google.ie/search*"
            ],
            "js": ["config.js", "content.js"],
            "css": ["content.css"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_icon": {
            "16": "icon-isi-16.png",
            "48": "icon-isi-48.png",
            "128": "icon-isi-128.png"
        },
        "default_title": "Investigating Search Interface",
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icon-isi-16.png",
        "48": "icon-isi-48.png",
        "128": "icon-isi-128.png"
    }
}
